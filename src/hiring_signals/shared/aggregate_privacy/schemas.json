{
  "partition": {
    "$defs": {
      "Cell": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "enum": [
              "positive",
              "negative",
              "not_stated",
              "conflicting",
              "uncertain",
              "error",
              "blocked",
              "junior",
              "mid",
              "senior",
              "staff_or_lead",
              "multiple",
              "remote",
              "hybrid",
              "onsite",
              "full_time",
              "part_time",
              "contract",
              "internship",
              "stated_normalized",
              "stated_unknown_units"
            ],
            "title": "Label",
            "type": "string"
          },
          "numerator": {
            "maximum": 9223372036854775807,
            "minimum": 0,
            "title": "Numerator",
            "type": "integer"
          },
          "uncertainty": {
            "anyOf": [
              {
                "$ref": "#/$defs/Interval"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "label",
          "numerator",
          "uncertainty"
        ],
        "title": "Cell",
        "type": "object"
      },
      "Interval": {
        "additionalProperties": false,
        "properties": {
          "lower": {
            "maximum": 1,
            "minimum": 0,
            "title": "Lower",
            "type": "number"
          },
