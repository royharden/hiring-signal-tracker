        "title": "Evidence Category",
        "type": "string"
      },
      "coverage": {
        "enum": [
          "complete",
          "partial",
          "failed"
        ],
        "title": "Coverage",
        "type": "string"
      },
      "denominator": {
        "maximum": 9223372036854775807,
        "minimum": 0,
        "title": "Denominator",
        "type": "integer"
      },
      "cells": {
        "items": {
          "$ref": "#/$defs/Cell"
        },
        "maxItems": 10,
        "minItems": 2,
        "title": "Cells",
        "type": "array"
      }
