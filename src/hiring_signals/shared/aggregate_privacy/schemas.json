        "type": "string"
      },
      "version_sha256": {
        "pattern": "^[0-9a-f]{64}$",
        "title": "Version Sha256",
        "type": "string"
      },
      "evidence_category": {
        "enum": [
          "prediction",
          "synthetic_expectation",
          "human_self_attested"
