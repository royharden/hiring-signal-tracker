{
  "$defs": {
    "BooleanJudgment": {
      "additionalProperties": false,
      "description": "Absent is null/ok/absent; an explicit negative is false/ok/explicit_negative.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/CandidateReference"
          },
          "maxItems": 8,
          "title": "Candidates",
          "type": "array"
        },
        "certainty": {
          "anyOf": [
            {
              "$ref": "#/$defs/Certainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "provider_error",
                "invalid_output",
                "candidate_missing",
                "screen_hold"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        },
        "evidence_state": {
          "enum": [
            "absent",
            "explicit_positive",
            "explicit_negative",
            "multiple",
            "conflicting",
            "uncertain",
            "unavailable"
          ],
          "title": "Evidence State",
          "type": "string"
        },
        "process_status": {
          "enum": [
            "ok",
            "abstained",
            "error",
            "blocked"
          ],
          "title": "Process Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "evidence_state",
        "process_status",
        "certainty",
        "candidates",
        "error_code",
        "value"
      ],
      "title": "BooleanJudgment",
      "type": "object"
    },
    "CandidateReference": {
      "additionalProperties": false,
      "description": "Coordinates only, never snippets, names, URLs or source identifiers.\n\nByte coordinates refer to a transient input with this digest. This validates\nshape and bounds, not candidate recall or correspondence to actual input.",
      "properties": {
        "end_byte": {
          "exclusiveMinimum": 0,
          "maximum": 32768,
          "title": "End Byte",
          "type": "integer"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "start_byte": {
          "exclusiveMaximum": 32768,
          "minimum": 0,
          "title": "Start Byte",
          "type": "integer"
        }
      },
      "required": [
        "input_sha256",
        "start_byte",
        "end_byte"
      ],
      "title": "CandidateReference",
      "type": "object"
    },
    "Certainty": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "native_probability",
            "self_reported_confidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Certainty",
      "type": "object"
    },
    "Classification": {
      "additionalProperties": false,
      "properties": {
        "ai_engineering_role": {
          "$ref": "#/$defs/BooleanJudgment"
        },
        "employment": {
