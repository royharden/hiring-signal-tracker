    "LabelProvenance": {
      "additionalProperties": false,
      "description": "Self-attested human provenance is not authentication or supplied human gold.",
      "properties": {
        "actor_ref": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Ref"
        },
        "attestation_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attestation Sha256"
        },
        "source": {
          "enum": [
            "unprovided",
            "synthetic_expectation",
            "human_self_attested"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "actor_ref",
        "attestation_sha256"
      ],
      "title": "LabelProvenance",
      "type": "object"
    },
    "NormalizedSalary": {
      "additionalProperties": false,
      "description": "Unit-preserving decimal range; no annual conversion or inferred units.",
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "EUR",
            "GBP",
            "CAD",
            "AUD",
            "JPY",
            "CHF",
            "INR"
          ],
          "title": "Currency",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Minimum"
        },
        "period": {
          "enum": [
            "hour",
            "day",
            "week",
            "month",
            "year"
          ],
          "title": "Period",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "currency",
        "period"
      ],
      "title": "NormalizedSalary",
      "type": "object"
    },
