        },
        "work_mode": {
          "$ref": "#/$defs/WorkModeJudgment"
        }
      },
      "required": [
        "ai_engineering_role",
        "portfolio_requested",
        "seniority",
        "work_mode",
        "employment",
        "skills",
        "salary",
        "location_stated"
      ],
      "title": "Classification",
      "type": "object"
    },
