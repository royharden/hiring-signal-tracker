  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed private derivation; neither raw text nor a public per-item output type.\n\nID generation, source mapping, storage and aggregate privacy are unimplemented.\nDigest syntax does not prove HMAC generation or authentication.",
  "properties": {
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "implementation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Sha256",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "item_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Item Id",
      "type": "string"
    },
    "method": {
      "enum": [
        "rules",
        "jev",
        "generative",
        "dev_majority",
        "human"
      ],
      "title": "Method",
      "type": "string"
    },
    "model_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model Sha256"
    },
    "month": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
      "title": "Month",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/LabelProvenance"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "taxonomy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Taxonomy Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "item_id",
    "month",
    "input_sha256",
    "taxonomy_sha256",
    "config_sha256",
    "implementation_sha256",
    "method",
    "model_sha256",
    "provenance",
    "classification"
  ],
  "title": "PrivateDerivedRecord",
  "type": "object",
  "x-runtime-validators-required": true
}
