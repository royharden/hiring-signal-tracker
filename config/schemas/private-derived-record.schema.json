              "type": "null"
            }
          ],
          "title": "Stated Minimum"
        }
      },
      "required": [
        "presence",
        "stated_minimum",
        "stated_maximum",
        "currency",
        "period",
        "normalization_status",
        "normalized"
      ],
      "title": "SalaryJudgment",
      "type": "object"
    },
